# Après émission Let’s Encrypt : HTTP redirige vers HTTPS ; TLS = certificats LE.
# Le challenge ACME reste sur 8080 (renouvellement HTTP-01).

server {
    listen 8080;
    server_name ${CERTBOT_DOMAIN};
    set $upstream_app http://app:3000;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Cookie dp_session Secure : forcer HTTPS une fois le vrai certificat en place.
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 8443 ssl;
    http2 on;
    server_name ${CERTBOT_DOMAIN};
    set $upstream_app http://app:3000;

    ssl_certificate     ${SSL_CERT};
    ssl_certificate_key ${SSL_KEY};
    ssl_protocols       TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000" always;

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /_next/static/ {
        include /etc/nginx/proxy_params;
        proxy_pass $upstream_app;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        include /etc/nginx/proxy_params;
        proxy_pass $upstream_app;
        add_header Cache-Control "no-store" always;
    }
}
