# Application
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=Dubai Phone
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dubai_phone?schema=public

# Mot de passe des comptes de démo (seed). À renseigner dans .env uniquement.
SEED_USER_PASSWORD=

# Auth / edge
# Mettre à 1 uniquement derrière un reverse-proxy de confiance (nginx, Caddy, …)
# qui fixe X-Forwarded-For / X-Real-IP. Sinon ces en-têtes sont ignorés.
# TRUSTED_PROXY=1

# Optional observability
# LOG_LEVEL=info

# Session : jetons aléatoires hashés en base (pas de JWT secret à configurer).
# Rate-limit login : mémoire processus en MVP — Redis requis en multi-instances (ADR-0008).
