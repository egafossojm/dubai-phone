# Application
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=Dubai Phone
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL) — obligatoire en NODE_ENV=production
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dubai_phone?schema=public

# Mot de passe des comptes de démo (seed). À renseigner dans .env uniquement.
SEED_USER_PASSWORD=

# Auth / edge — Compose met TRUSTED_PROXY=1 (Nginx dans le réseau Docker).
# Nginx écrase X-Forwarded-For avec $remote_addr (docs/ops/08-nginx.md).
TRUSTED_PROXY=1

# Observabilité (stdout JSON)
# LOG_LEVEL=info

# Seed : interdit en NODE_ENV=production sauf ALLOW_PROD_SEED=1 (bootstrap contrôlé).
# ALLOW_PROD_SEED=1

# --- Docker Compose ---
# POSTGRES_PASSWORD et DATABASE_URL doivent être définis (pas de défauts secrets).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dubai_phone
POSTGRES_PORT=5432
# Pour le service app, l’hôte DB est `db` (pas localhost) :
# DATABASE_URL=postgresql://postgres:postgres@db:5432/dubai_phone?schema=public
RUN_MIGRATE_ON_START=1

# Nginx (conteneur, ports hôte → 8080/8443 dans l’image)
# NGINX_HTTP_PORT=80
# NGINX_HTTPS_PORT=443

# Let’s Encrypt (laisser vide en local : Certbot attend sans émettre).
# Prod : domaine = hôte de NEXT_PUBLIC_APP_URL (sans https://).
# CERTBOT_DOMAIN=pos.exemple.cm
# CERTBOT_EMAIL=ops@exemple.cm
# CERTBOT_STAGING=1

# Session : jetons aléatoires hashés en base (pas de JWT secret à configurer).
# Rate-limit login : mémoire **du service identity** — Redis requis en multi-instances (ADR-0008).

# Microservices Python (Compose les positionne automatiquement).
# Vide en local `npm run dev` / Vitest = handlers Next.js in-process.
# IDENTITY_URL=http://127.0.0.1:8001
# CATALOG_URL=http://127.0.0.1:8002
# REPORTING_URL=http://127.0.0.1:8004
