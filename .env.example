# Application
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=Dubai Phone
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dubai_phone?schema=public

# Mot de passe des comptes de démo (seed). À renseigner dans .env uniquement.
SEED_USER_PASSWORD=

# Optional observability
# LOG_LEVEL=info
